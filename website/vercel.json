{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/ingest/static/(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/$1"
    },
    {
      "source": "/ingest/array/:token/config/",
      "destination": "https://eu-assets.i.posthog.com/array/:token/config"
    },
    {
      "source": "/ingest/array/(.*)",
      "destination": "https://eu-assets.i.posthog.com/array/$1"
    },
    { "source": "/ingest/(.*)", "destination": "https://eu.i.posthog.com/$1" }
  ]
}
