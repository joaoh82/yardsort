{
  "name": "@yardsort/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo prebuild --platform ios --no-install && expo run:ios --device",
    "android": "expo prebuild --platform android --no-install && expo run:android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p terminal",
    "lint": "eslint .",
    "test": "bun test test/lib && jest"
  },
  "dependencies": {
    "@expo/log-box": "58.0.14",
    "@expo/metro-runtime": "58.0.16",
    "@yardsort/remote-client": "file:../../packages/remote-client",
    "expo": "58.0.22",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/screens/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/test/screens/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|expo-router|standard-navigation|react-navigation|@react-navigation/.*|@yardsort/.*)"
    ]
  }
}
