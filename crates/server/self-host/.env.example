# Copy this to `.env`, next to compose.yaml, and fill it in. `.env` holds secrets: keep it out of
# git (the repository ignores it) and readable by you alone (`chmod 600 .env`). Back it up: without
# ZITADEL_MASTERKEY, ZITADEL cannot read its own data.
#
# Make each secret with `openssl rand -hex 16` (the master key) or `openssl rand -hex 24` (the
# rest): hex needs no escaping anywhere it goes.

# The two public names, each with a DNS record pointing at this machine.
AUTH_DOMAIN=auth.example.com
REMOTE_DOMAIN=remote.example.com
# Let's Encrypt writes here about the certificates.
ACME_EMAIL=you@example.com

# Exactly 32 characters.
ZITADEL_MASTERKEY=
POSTGRES_PASSWORD=
YARDSORT_DB_PASSWORD=
ZITADEL_LOGIN_COOKIE_SECRET=

# ZITADEL's first administrator. You choose a new password at the first sign-in.
ZITADEL_ADMIN_EMAIL=
ZITADEL_ADMIN_PASSWORD=

# Filled in at step 4 of the README, from the application you create in ZITADEL.
YARDSORT_OIDC_CLIENT_ID=
YARDSORT_OIDC_CLIENT_SECRET=

# Optional. Phone notifications. Leave these empty and notices wait on the server.
# Set the key or the key file, not both. See docs/design/40-mobile-notifications.md.
# YARDSORT_APNS_KEY_ID=
# YARDSORT_APNS_TEAM_ID=
# YARDSORT_APNS_BUNDLE_ID=dev.yardsort.mobile
# YARDSORT_APNS_KEY=
# YARDSORT_APNS_KEY_FILE=
# YARDSORT_APNS_SANDBOX=
# YARDSORT_FCM_CREDENTIALS=
# YARDSORT_FCM_CREDENTIALS_FILE=
# YARDSORT_FCM_PROJECT_ID=
